{
  "schemaVersion": 1,
  "id": "jerinin-addon",
  "version": "${version}",
  "name": "Jerinin Addon",
  "description": "Meteor Client 自动化扩展，提供附魔助手、圆石出售、传送重锤与界面汉化。",
  "authors": [
    "Jerinin"
  ],
  "contact": {
    "homepage": "https://github.com/fxjcangku/jerinin-addon",
    "sources": "https://github.com/fxjcangku/jerinin-addon",
    "issues": "https://github.com/fxjcangku/jerinin-addon/issues"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.addon.AddonTemplate"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
